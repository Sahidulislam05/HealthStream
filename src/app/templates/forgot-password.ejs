
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Password Reset</title>

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background: #f3f6ff;
      font-family: "Inter", Arial, Helvetica, sans-serif;
      color: #1f2937;
    }

    table {
      border-spacing: 0;
    }

    img {
      border: 0;
      max-width: 100%;
    }

    .email-wrapper {
      width: 100%;
      padding: 45px 15px;
      background:
        radial-gradient(
          circle at top left,
          rgba(99, 102, 241, 0.18),
          transparent 35%
        ),
        radial-gradient(
          circle at bottom right,
          rgba(236, 72, 153, 0.18),
          transparent 35%
        ),
        #f3f6ff;
    }

    .email-container {
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow:
        0 25px 70px rgba(45, 55, 72, 0.12),
        0 8px 25px rgba(99, 102, 241, 0.08);
    }

    .hero {
      position: relative;
      padding: 45px 40px 55px;
      text-align: center;
      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(255, 255, 255, 0.25),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 80%,
          rgba(255, 255, 255, 0.15),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #4f46e5 0%,
          #6366f1 38%,
          #ec4899 100%
        );
    }

    .hero::after {
      content: "";
      display: block;
      position: absolute;
      width: 180px;
      height: 180px;
      right: -90px;
      top: -90px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.10);
    }

    .hero::before {
      content: "";
      display: block;
      position: absolute;
      width: 120px;
      height: 120px;
      left: -60px;
      bottom: -60px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .logo-wrapper {
      position: relative;
      z-index: 2;
      width: 68px;
      height: 68px;
      margin: 0 auto 22px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.18);
      border: 1px solid rgba(255, 255, 255, 0.30);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .logo-icon {
      font-size: 30px;
      line-height: 68px;
      color: #ffffff;
    }

    .hero-title {
      position: relative;
      z-index: 2;
      margin: 0;
      color: #ffffff;
      font-size: 30px;
      line-height: 1.25;
      font-weight: 800;
      letter-spacing: -0.6px;
    }

    .hero-subtitle {
      position: relative;
      z-index: 2;
      max-width: 430px;
      margin: 14px auto 0;
      color: rgba(255, 255, 255, 0.88);
      font-size: 14px;
      line-height: 1.7;
      font-weight: 400;
    }

    .content {
      padding: 40px;
    }

    .greeting {
      margin: 0 0 10px;
      color: #111827;
      font-size: 17px;
      font-weight: 700;
    }

    .description {
      margin: 0;
      color: #64748b;
      font-size: 14px;
      line-height: 1.8;
    }

    .otp-section {
      margin: 32px 0;
      padding: 28px 20px;
      text-align: center;
      border-radius: 18px;
      background:
        linear-gradient(
          135deg,
          rgba(79, 70, 229, 0.07),
          rgba(236, 72, 153, 0.07)
        );
      border: 1px solid rgba(99, 102, 241, 0.12);
    }

    .otp-label {
      margin: 0 0 14px;
      color: #64748b;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.8px;
    }

    .otp {
      display: inline-block;
      padding: 14px 25px;
      border-radius: 12px;
      background: linear-gradient(
        135deg,
        #4f46e5,
        #ec4899
      );
      color: #ffffff;
      font-size: 32px;
      font-weight: 800;
      letter-spacing: 9px;
      line-height: 1;
      box-shadow:
        0 10px 25px rgba(99, 102, 241, 0.25);
    }

    .expiration {
      margin: 16px 0 0;
      color: #64748b;
      font-size: 12px;
      line-height: 1.6;
    }

    .expiration strong {
      color: #4f46e5;
    }

    .security-box {
      display: table;
      width: 100%;
      margin-top: 25px;
      padding: 18px;
      border-radius: 14px;
      background: #fff7ed;
      border: 1px solid #fed7aa;
    }

    .security-icon {
      display: table-cell;
      width: 35px;
      vertical-align: top;
      font-size: 18px;
    }

    .security-text {
      display: table-cell;
      vertical-align: top;
      color: #9a3412;
      font-size: 12px;
      line-height: 1.7;
    }

    .divider {
      height: 1px;
      margin: 32px 0 24px;
      background: #e5e7eb;
    }

    .footer {
      text-align: center;
      padding: 0 40px 35px;
    }

    .footer-brand {
      margin: 0 0 8px;
      color: #4f46e5;
      font-size: 14px;
      font-weight: 800;
    }

    .footer-text {
      margin: 0;
      color: #94a3b8;
      font-size: 11px;
      line-height: 1.7;
    }

    .footer-links {
      margin-top: 12px;
      font-size: 11px;
    }

    .footer-links a {
      color: #6366f1;
      text-decoration: none;
    }

    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 20px 10px;
      }

      .hero {
        padding: 35px 25px 45px;
      }

      .content {
        padding: 30px 22px;
      }

      .footer {
        padding: 0 22px 30px;
      }

      .hero-title {
        font-size: 25px;
      }

      .hero-subtitle {
        font-size: 13px;
      }

      .otp {
        font-size: 27px;
        letter-spacing: 7px;
        padding: 13px 20px;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
    >
      <tr>
        <td align="center">

          <table
            role="presentation"
            class="email-container"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
          >

            <!-- ================= HERO ================= -->

            <tr>
              <td class="hero">

                <div class="logo-wrapper">
                  <div class="logo-icon">
                    🔐
                  </div>
                </div>

                <!-- <h1 class="hero-title">
                  Reset Your Password.
                </h1> -->

                <p class="hero-subtitle">
                  We received a request to reset the password
                  associated with your HealthStream System account.
                </p>

              </td>
            </tr>

            <!-- ================= CONTENT ================= -->

            <tr>
              <td class="content">

                <p class="greeting">
                  Hello <%= name %> 👋
                </p>

                <p class="description">
                  Someone requested a password reset for your account.
                  If this was you, use the verification code below
                  to securely continue resetting your password.
                </p>


                <!-- ================= OTP ================= -->

                <div class="otp-section">

                  <p class="otp-label">
                    Your Verification Code
                  </p>

                  <div class="otp">
                    <%= otp %>
                  </div>

                  <p class="expiration">
                    This code will expire in
                    <strong>
                      <%= expirationMinutes %> minutes
                    </strong>.
                  </p>

                </div>


                <!-- ================= SECURITY NOTICE ================= -->

                <div class="security-box">

                  <div class="security-icon">
                    🛡️
                  </div>

                  <div class="security-text">
                    <strong>Security notice:</strong>
                    Never share this OTP with anyone.
                    HealthStream System will never ask you
                    for your verification code by phone, email,
                    or message.
                  </div>

                </div>


                <div class="divider"></div>

                <p class="description">
                  Didn't request a password reset?
                  You can safely ignore this email.
                  Your account will remain secure and your password
                  will not be changed.
                </p>

              </td>
            </tr>

            <!-- ================= FOOTER ================= -->

            <tr>
              <td class="footer">

                <p class="footer-brand">
                  HealthStream
                </p>

                <p class="footer-text">
                  Secure healthcare management, built for you.
                </p>

                <p class="footer-text">
                  &copy; <%= new Date().getFullYear() %>
                  HealthStream System.
                  All rights reserved.
                </p>

                <div class="footer-links">
                  <a href="#">
                    Privacy Policy
                  </a>

                  &nbsp;&nbsp;•&nbsp;&nbsp;

                  <a href="#">
                    Support
                  </a>
                </div>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </div>

</body>
</html>

