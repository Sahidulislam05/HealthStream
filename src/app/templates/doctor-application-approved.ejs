
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Application Approved</title>

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background: #f3f6ff;
      color: #1f2937;
      font-family: "Inter", Arial, Helvetica, sans-serif;
    }

    table {
      border-spacing: 0;
    }

    .email-wrapper {
      width: 100%;
      padding: 45px 15px;

      background:
        radial-gradient(
          circle at top left,
          rgba(99, 102, 241, 0.18),
          transparent 35%
        ),
        radial-gradient(
          circle at bottom right,
          rgba(236, 72, 153, 0.16),
          transparent 35%
        ),
        #f3f6ff;
    }

    .email-container {
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
      overflow: hidden;

      background: #ffffff;

      border-radius: 24px;

      box-shadow:
        0 25px 70px rgba(45, 55, 72, 0.12),
        0 8px 25px rgba(99, 102, 241, 0.08);
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      position: relative;
      overflow: hidden;

      padding: 48px 40px 58px;

      text-align: center;

      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(255, 255, 255, 0.28),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 80%,
          rgba(255, 255, 255, 0.16),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #4f46e5 0%,
          #6366f1 40%,
          #ec4899 100%
        );
    }

    .hero::before {
      content: "";

      position: absolute;

      width: 170px;
      height: 170px;

      left: -85px;
      bottom: -85px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.08);
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 210px;
      height: 210px;

      right: -105px;
      top: -105px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.10);
    }

    /* =========================
       APPROVED ICON
    ========================== */

    .icon-wrapper {
      position: relative;
      z-index: 2;

      width: 86px;
      height: 86px;

      margin: 0 auto 22px;

      padding: 7px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.18);

      border: 1px solid rgba(255, 255, 255, 0.32);

      box-shadow:
        0 15px 35px rgba(0, 0, 0, 0.13);
    }

    .approved-icon {
      width: 72px;
      height: 72px;

      border-radius: 50%;

      background: #ffffff;

      color: #16a34a;

      font-size: 35px;
      font-weight: 800;

      line-height: 72px;

      text-align: center;
    }

    /* =========================
       HERO TEXT
    ========================== */

    .hero-title {
      position: relative;
      z-index: 2;

      margin: 0;

      color: #ffffff;

      font-size: 30px;

      line-height: 1.3;

      font-weight: 800;

      letter-spacing: -0.7px;
    }

    .hero-subtitle {
      position: relative;
      z-index: 2;

      max-width: 450px;

      margin: 14px auto 0;

      color: rgba(255, 255, 255, 0.90);

      font-size: 14px;

      line-height: 1.75;
    }

    /* =========================
       CONTENT
    ========================== */

    .content {
      padding: 40px;
    }

    .greeting {
      margin: 0 0 10px;

      color: #111827;

      font-size: 18px;

      font-weight: 700;
    }

    .description {
      margin: 0;

      color: #64748b;

      font-size: 14px;

      line-height: 1.85;
    }

    /* =========================
       APPROVAL CARD
    ========================== */

    .approval-card {
      position: relative;

      margin: 30px 0;

      padding: 26px;

      overflow: hidden;

      border-radius: 19px;

      background:
        linear-gradient(
          135deg,
          #f0fdf4,
          #eff6ff
        );

      border: 1px solid #bbf7d0;
    }

    .approval-card::after {
      content: "";

      position: absolute;

      width: 120px;
      height: 120px;

      right: -60px;
      top: -60px;

      border-radius: 50%;

      background: rgba(34, 197, 94, 0.07);
    }

    .approval-header {
      position: relative;
      z-index: 2;

      display: table;

      width: 100%;
    }

    .approval-icon {
      display: table-cell;

      width: 48px;

      vertical-align: top;
    }

    .approval-icon span {
      display: inline-block;

      width: 38px;
      height: 38px;

      border-radius: 11px;

      background: #dcfce7;

      color: #15803d;

      font-size: 19px;

      line-height: 38px;

      text-align: center;
    }

    .approval-content {
      display: table-cell;

      vertical-align: top;
    }

    .approval-title {
      margin: 0 0 5px;

      color: #166534;

      font-size: 16px;

      font-weight: 800;
    }

    .approval-text {
      margin: 0;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;
    }

    /* =========================
       DOCTOR FEATURES
    ========================== */

    .features-title {
      margin: 0 0 16px;

      color: #1e293b;

      font-size: 15px;

      font-weight: 700;
    }

    .feature {
      display: table;

      width: 100%;

      margin-bottom: 13px;

      padding: 15px;

      border-radius: 14px;

      background: #f8fafc;

      border: 1px solid #e2e8f0;
    }

    .feature:last-child {
      margin-bottom: 0;
    }

    .feature-icon {
      display: table-cell;

      width: 46px;

      vertical-align: middle;
    }

    .feature-icon span {
      display: inline-block;

      width: 36px;
      height: 36px;

      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          #eef2ff,
          #fce7f3
        );

      font-size: 18px;

      line-height: 36px;

      text-align: center;
    }

    .feature-content {
      display: table-cell;

      vertical-align: middle;
    }

    .feature-title {
      margin: 0 0 3px;

      color: #334155;

      font-size: 13px;

      font-weight: 700;
    }

    .feature-text {
      margin: 0;

      color: #94a3b8;

      font-size: 11px;

      line-height: 1.5;
    }

    /* =========================
       CTA
    ========================== */

    .cta-section {
      margin-top: 30px;

      padding: 29px 20px;

      text-align: center;

      border-radius: 19px;

      background:
        linear-gradient(
          135deg,
          #f5f3ff,
          #fdf2f8
        );

      border: 1px solid rgba(99, 102, 241, 0.10);
    }

    .cta-title {
      margin: 0 0 8px;

      color: #1e1b4b;

      font-size: 16px;

      font-weight: 800;
    }

    .cta-text {
      max-width: 400px;

      margin: 0 auto 19px;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;
    }

    .cta-button {
      display: inline-block;

      padding: 13px 29px;

      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          #4f46e5,
          #ec4899
        );

      color: #ffffff !important;

      font-size: 13px;

      font-weight: 700;

      text-decoration: none;

      box-shadow:
        0 9px 23px rgba(99, 102, 241, 0.22);
    }

    /* =========================
       SECURITY
    ========================== */

    .security-box {
      display: table;

      width: 100%;

      margin-top: 25px;

      padding: 18px;

      border-radius: 14px;

      background: #f0fdf4;

      border: 1px solid #bbf7d0;
    }

    .security-icon {
      display: table-cell;

      width: 35px;

      vertical-align: top;

      font-size: 18px;
    }

    .security-text {
      display: table-cell;

      vertical-align: top;

      color: #166534;

      font-size: 12px;

      line-height: 1.7;
    }

    /* =========================
       DIVIDER
    ========================== */

    .divider {
      height: 1px;

      margin: 32px 0 24px;

      background: #e5e7eb;
    }

    /* =========================
       FOOTER
    ========================== */

    .footer {
      padding: 0 40px 35px;

      text-align: center;
    }

    .footer-brand {
      margin: 0 0 8px;

      color: #4f46e5;

      font-size: 14px;

      font-weight: 800;
    }

    .footer-text {
      margin: 0;

      color: #94a3b8;

      font-size: 11px;

      line-height: 1.7;
    }

    .footer-links {
      margin-top: 12px;

      font-size: 11px;
    }

    .footer-links a {
      color: #6366f1;

      text-decoration: none;
    }

    /* =========================
       MOBILE
    ========================== */

    @media only screen and (max-width: 600px) {

      .email-wrapper {
        padding: 20px 10px;
      }

      .hero {
        padding: 38px 25px 48px;
      }

      .content {
        padding: 30px 22px;
      }

      .footer {
        padding: 0 22px 30px;
      }

      .hero-title {
        font-size: 25px;
      }

      .hero-subtitle {
        font-size: 13px;
      }

      .icon-wrapper {
        width: 76px;
        height: 76px;
      }

      .approved-icon {
        width: 62px;
        height: 62px;

        font-size: 30px;

        line-height: 62px;
      }

      .feature {
        padding: 13px;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
    >
      <tr>
        <td align="center">

          <table
            role="presentation"
            class="email-container"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
          >

            <!-- =========================
                 HERO
            ========================== -->

            <tr>
              <td class="hero">

                <div class="icon-wrapper">

                  <div class="approved-icon">
                    ✓
                  </div>

                </div>

                <h1 class="hero-title">
                  Congratulations, Dr. <%= name %>! 🎉
                </h1>

                <p class="hero-subtitle">
                  Your application has been reviewed
                  and officially approved.
                </p>

              </td>
            </tr>


            <!-- =========================
                 CONTENT
            ========================== -->

            <tr>
              <td class="content">

                <p class="greeting">
                  Welcome to the team, Dr. <%= name %> 👋
                </p>

                <p class="description">
                  We're delighted to let you know that your
                  application to join
                  <strong>HealthStream System</strong>
                  as a doctor has been successfully reviewed
                  and approved.
                </p>


                <!-- =========================
                     APPROVAL CARD
                ========================== -->

                <div class="approval-card">

                  <div class="approval-header">

                    <div class="approval-icon">
                      <span>✓</span>
                    </div>

                    <div class="approval-content">

                      <p class="approval-title">
                        Application Approved
                      </p>

                      <p class="approval-text">
                        You are now officially approved to
                        join HealthStream System as a doctor
                        and can begin using your professional
                        account.
                      </p>

                    </div>

                  </div>

                </div>


                <!-- =========================
                     FEATURES
                ========================== -->

                <p class="features-title">
                  What you can do now
                </p>


                <div class="feature">

                  <div class="feature-icon">
                    <span>📅</span>
                  </div>

                  <div class="feature-content">

                    <p class="feature-title">
                      Manage Your Schedule
                    </p>

                    <p class="feature-text">
                      Set your availability and manage
                      upcoming appointments.
                    </p>

                  </div>

                </div>


                <div class="feature">

                  <div class="feature-icon">
                    <span>🩺</span>
                  </div>

                  <div class="feature-content">

                    <p class="feature-title">
                      Manage Consultations
                    </p>

                    <p class="feature-text">
                      Review and manage your patient
                      consultations from your dashboard.
                    </p>

                  </div>

                </div>


                <div class="feature">

                  <div class="feature-icon">
                    <span>👥</span>
                  </div>

                  <div class="feature-content">

                    <p class="feature-title">
                      Connect With Patients
                    </p>

                    <p class="feature-text">
                      Provide professional healthcare
                      services through the platform.
                    </p>

                  </div>

                </div>


                <!-- =========================
                     CTA
                ========================== -->

                <div class="cta-section">

                  <p class="cta-title">
                    Ready to begin?
                  </p>

                  <p class="cta-text">
                    Log in to your doctor account and
                    start managing your schedule,
                    consultations, and professional profile.
                  </p>

                  <a
                    href="#"
                    class="cta-button"
                  >
                    Open Doctor Dashboard →
                  </a>

                </div>


                <!-- =========================
                     SECURITY
                ========================== -->

                <div class="security-box">

                  <div class="security-icon">
                    🛡️
                  </div>

                  <div class="security-text">
                    <strong>Keep your account secure.</strong>
                    Never share your password or login
                    credentials with anyone. HealthStream
                    System will never ask for your password.
                  </div>

                </div>


                <div class="divider"></div>

                <p class="description">
                  We're excited to have you join our healthcare
                  community and look forward to working with you.
                  Welcome aboard!
                </p>

              </td>
            </tr>


            <!-- =========================
                 FOOTER
            ========================== -->

            <tr>
              <td class="footer">

                <p class="footer-brand">
                  HealthStream
                </p>

                <p class="footer-text">
                  Secure healthcare management, built for you.
                </p>

                <p class="footer-text">
                  &copy; <%= new Date().getFullYear() %>
                  HealthStream System.
                  All rights reserved.
                </p>

                <div class="footer-links">

                  <a href="#">
                    Privacy Policy
                  </a>

                  &nbsp;&nbsp;•&nbsp;&nbsp;

                  <a href="#">
                    Support
                  </a>

                </div>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </div>

</body>
</html>
