
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Password Reset Successful</title>

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background: #f3f6ff;
      color: #1f2937;
      font-family: "Inter", Arial, Helvetica, sans-serif;
    }

    table {
      border-spacing: 0;
    }

    .email-wrapper {
      width: 100%;
      padding: 45px 15px;
      background:
        radial-gradient(
          circle at top left,
          rgba(99, 102, 241, 0.18),
          transparent 35%
        ),
        radial-gradient(
          circle at bottom right,
          rgba(236, 72, 153, 0.18),
          transparent 35%
        ),
        #f3f6ff;
    }

    .email-container {
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
      overflow: hidden;
      background: #ffffff;
      border-radius: 24px;
      box-shadow:
        0 25px 70px rgba(45, 55, 72, 0.12),
        0 8px 25px rgba(99, 102, 241, 0.08);
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      position: relative;
      overflow: hidden;
      padding: 45px 40px 55px;
      text-align: center;
      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(255, 255, 255, 0.25),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 80%,
          rgba(255, 255, 255, 0.15),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #4f46e5 0%,
          #6366f1 38%,
          #ec4899 100%
        );
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 150px;
      height: 150px;
      left: -75px;
      bottom: -75px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 190px;
      height: 190px;
      right: -95px;
      top: -95px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.10);
    }

    /* =========================
       SUCCESS ICON
    ========================== */

    .success-icon-wrapper {
      position: relative;
      z-index: 2;
      width: 82px;
      height: 82px;
      margin: 0 auto 22px;
      padding: 7px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      border: 1px solid rgba(255, 255, 255, 0.30);
      box-shadow:
        0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .success-icon {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: #ffffff;
      color: #16a34a;
      font-size: 34px;
      font-weight: 800;
      line-height: 68px;
      text-align: center;
    }

    .hero-title {
      position: relative;
      z-index: 2;
      margin: 0;
      color: #ffffff;
      font-size: 29px;
      line-height: 1.3;
      font-weight: 800;
      letter-spacing: -0.6px;
    }

    .hero-subtitle {
      position: relative;
      z-index: 2;
      max-width: 440px;
      margin: 14px auto 0;
      color: rgba(255, 255, 255, 0.88);
      font-size: 14px;
      line-height: 1.7;
    }

    /* =========================
       CONTENT
    ========================== */

    .content {
      padding: 40px;
    }

    .greeting {
      margin: 0 0 10px;
      color: #111827;
      font-size: 17px;
      font-weight: 700;
    }

    .description {
      margin: 0;
      color: #64748b;
      font-size: 14px;
      line-height: 1.8;
    }

    /* =========================
       SUCCESS CARD
    ========================== */

    .success-card {
      margin: 30px 0;
      padding: 24px;
      border-radius: 18px;
      background:
        linear-gradient(
          135deg,
          rgba(22, 163, 74, 0.07),
          rgba(79, 70, 229, 0.06)
        );
      border: 1px solid rgba(22, 163, 74, 0.14);
    }

    .success-card-title {
      margin: 0 0 8px;
      color: #15803d;
      font-size: 15px;
      font-weight: 700;
    }

    .success-card-text {
      margin: 0;
      color: #64748b;
      font-size: 13px;
      line-height: 1.7;
    }

    /* =========================
       LOGIN CTA
    ========================== */

    .login-section {
      margin-top: 30px;
      padding: 25px;
      text-align: center;
      border-radius: 18px;
      background:
        linear-gradient(
          135deg,
          #f5f3ff,
          #fdf2f8
        );
      border: 1px solid rgba(99, 102, 241, 0.10);
    }

    .login-title {
      margin: 0 0 8px;
      color: #1e1b4b;
      font-size: 15px;
      font-weight: 700;
    }

    .login-text {
      margin: 0 0 18px;
      color: #64748b;
      font-size: 12px;
      line-height: 1.7;
    }

    .login-button {
      display: inline-block;
      padding: 13px 27px;
      border-radius: 10px;
      background: linear-gradient(
        135deg,
        #4f46e5,
        #ec4899
      );
      color: #ffffff !important;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      box-shadow:
        0 8px 20px rgba(99, 102, 241, 0.22);
    }

    /* =========================
       SECURITY NOTICE
    ========================== */

    .security-box {
      display: table;
      width: 100%;
      margin-top: 25px;
      padding: 18px;
      border-radius: 14px;
      background: #fff7ed;
      border: 1px solid #fed7aa;
    }

    .security-icon {
      display: table-cell;
      width: 35px;
      vertical-align: top;
      font-size: 18px;
    }

    .security-text {
      display: table-cell;
      vertical-align: top;
      color: #9a3412;
      font-size: 12px;
      line-height: 1.7;
    }

    /* =========================
       DIVIDER
    ========================== */

    .divider {
      height: 1px;
      margin: 32px 0 24px;
      background: #e5e7eb;
    }

    /* =========================
       FOOTER
    ========================== */

    .footer {
      padding: 0 40px 35px;
      text-align: center;
    }

    .footer-brand {
      margin: 0 0 8px;
      color: #4f46e5;
      font-size: 14px;
      font-weight: 800;
    }

    .footer-text {
      margin: 0;
      color: #94a3b8;
      font-size: 11px;
      line-height: 1.7;
    }

    .footer-links {
      margin-top: 12px;
      font-size: 11px;
    }

    .footer-links a {
      color: #6366f1;
      text-decoration: none;
    }

    /* =========================
       MOBILE
    ========================== */

    @media only screen and (max-width: 600px) {

      .email-wrapper {
        padding: 20px 10px;
      }

      .hero {
        padding: 35px 25px 45px;
      }

      .content {
        padding: 30px 22px;
      }

      .footer {
        padding: 0 22px 30px;
      }

      .hero-title {
        font-size: 25px;
      }

      .hero-subtitle {
        font-size: 13px;
      }

      .success-icon-wrapper {
        width: 74px;
        height: 74px;
      }

      .success-icon {
        width: 60px;
        height: 60px;
        line-height: 60px;
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
    >
      <tr>
        <td align="center">

          <table
            role="presentation"
            class="email-container"
            width="620"
            cellpadding="0"
            cellspacing="0"
            border="0"
          >

            <!-- =========================
                 HERO
            ========================== -->

            <tr>
              <td class="hero">

                <div class="success-icon-wrapper">
                  <div class="success-icon">
                    &#10003;
                  </div>
                </div>

                <!-- <h1 class="hero-title">
                  Password Reset Successful
                </h1> -->

                <p class="hero-subtitle">
                  Your account password has been updated
                  successfully and your account is ready to use.
                </p>

              </td>
            </tr>


            <!-- =========================
                 CONTENT
            ========================== -->

            <tr>
              <td class="content">

                <p class="greeting">
                  Hello <%= name %> 👋
                </p>

                <p class="description">
                  Your password for your
                  <strong>HealthStream System</strong>
                  account has been changed successfully.
                  You can now sign in using your new password.
                </p>


                <!-- =========================
                     SUCCESS CARD
                ========================== -->

                <div class="success-card">

                  <p class="success-card-title">
                    ✓ Password Updated Successfully
                  </p>

                  <p class="success-card-text">
                    Your old password is no longer valid.
                    For your security, please make sure your
                    new password is strong and unique.
                  </p>

                </div>


                <!-- =========================
                     LOGIN CTA
                ========================== -->

                <div class="login-section">

                  <p class="login-title">
                    Ready to get started?
                  </p>

                  <p class="login-text">
                    You can now securely access your
                    HealthStream System account.
                  </p>

                  <a
                    href="#"
                    class="login-button"
                  >
                    Go to Your Account →
                  </a>

                </div>


                <!-- =========================
                     SECURITY NOTICE
                ========================== -->

                <div class="security-box">

                  <div class="security-icon">
                    🛡️
                  </div>

                  <div class="security-text">
                    <strong>Didn't make this change?</strong>
                    If you did not reset your password,
                    please contact our support team immediately.
                    Your account security may be at risk.
                  </div>

                </div>


                <div class="divider"></div>

                <p class="description">
                  For your protection, we recommend keeping
                  your password private and never sharing your
                  login credentials with anyone.
                </p>

              </td>
            </tr>


            <!-- =========================
                 FOOTER
            ========================== -->

            <tr>
              <td class="footer">

                <p class="footer-brand">
                  HealthStream System
                </p>

                <p class="footer-text">
                  Secure healthcare management, built for you.
                </p>

                <p class="footer-text">
                  &copy; <%= new Date().getFullYear() %>
                  HealthStream System.
                  All rights reserved.
                </p>

                <div class="footer-links">

                  <a href="#">
                    Privacy Policy
                  </a>

                  &nbsp;&nbsp;•&nbsp;&nbsp;

                  <a href="#">
                    Support
                  </a>

                </div>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </div>

</body>
</html>
